# This template contains no credentials. Keep your filled .env private.
# The Python CLI reads exported environment variables; Docker Compose reads .env.
RAGKIT_DATA_DIR=.ragkit
RAGKIT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAGKIT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Optional override: native defaults to http://127.0.0.1:11434;
# Docker Compose defaults to http://host.docker.internal:11434.
# Leave unset to use the appropriate runtime default.
# OLLAMA_HOST=
RAGKIT_OLLAMA_MODEL=
OPENAI_API_KEY=
RAGKIT_OPENAI_MODEL=
ANTHROPIC_API_KEY=
RAGKIT_ANTHROPIC_MODEL=
